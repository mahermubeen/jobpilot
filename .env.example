# Everything is optional. Keys are normally entered in the app's Setup screen
# and stored in the local database under ./data (never committed).

# Where the local database lives (default: ./data)
# JOBPILOT_DATA_DIR=./data

# Set this to use a hosted Postgres (for example Supabase) instead of the
# embedded local database.
# DATABASE_URL=postgres://user:password@host:5432/postgres

# The API answers only JobPilot's own browser extension (its ID is fixed by the
# key in extension/manifest.json). Set this only if you packed your own build
# with a different key: paste the ID shown under JobPilot in chrome://extensions.
# JOBPILOT_EXTENSION_ID=

# Port for `npm run dev` / `npm start` (default: 3000)
# PORT=3000

# Mail servers. Defaults are Gmail; change these to use another provider
# (the address and password are still entered in Settings).
# JOBPILOT_SMTP_HOST=smtp.gmail.com
# JOBPILOT_SMTP_PORT=465
# JOBPILOT_SMTP_SECURE=true
# JOBPILOT_IMAP_HOST=imap.gmail.com
# JOBPILOT_IMAP_PORT=993
