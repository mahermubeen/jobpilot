#!/usr/bin/env bash
# Runs the full gate before every push: secrets (incl. history), format, lint
# (with the OOP/DSA limits in eslint.config.mjs), types, tests, build and audit.
# Enabled with: git config core.hooksPath .githooks
# A push of only deleted refs (nothing new to check) is let through.
set -uo pipefail
zero=0000000000000000000000000000000000000000
pushing=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" != "$zero" ] && pushing=1
done
[ "$pushing" = 1 ] || exit 0
if [ ! -x scripts/check.sh ]; then
  echo "pre-push: scripts/check.sh is missing or not executable. Push blocked." >&2
  exit 1
fi
echo "pre-push: running scripts/check.sh --full" >&2
scripts/check.sh --full || { echo "pre-push: the full gate failed. Fix it before pushing." >&2; exit 1; }
